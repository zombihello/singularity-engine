module TestDraw;
using "game/citadel/quad.h";
using "game/shared/ecs/ecs_render.gen.h";

component Quad
{
	defaults:
		pModel( Quad().GetModel() );
		
	CResourcePtr<IModel>    pModel;
}

[stage="on_update", profiler_group="scene"]
system QuadInit
{
	read: 				Quad quad;
	write_resource:		StudioScene		studioScene;
	exclude: 			StudioEntity;
}