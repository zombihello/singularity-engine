module TestDraw;
using "game/citadel/quad.h";
using "game/shared/ecs/ecs_render.gen.h";

component Quad
{
	defaults:
		pVertexBuffer( Quad().GetStudioAPIVertexBuffer() ),
		pIndexBuffer( Quad().GetStudioAPIIndexBuffer() ),
		pMaterial( Quad().GetMaterial() );
		
	CRefPtr<IStudioAPIBuffer>		pVertexBuffer;
	CRefPtr<IStudioAPIBuffer>		pIndexBuffer;
	[serialize][name="Material"] 
	CResourcePtr<IMaterial>			pMaterial;
}