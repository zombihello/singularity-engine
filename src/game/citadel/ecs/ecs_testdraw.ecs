module TestDraw;
using "game/citadel/quad.h";
using "game/shared/ecs/ecs_render.gen.h";

component Quad
{
	defaults:
		pModel( Quad().GetModel() ),
		pMaterial( Quad().GetMaterial() );
		
	CResourcePtr<IModel>    pModel;
	[serialize][name="Material"] 
	CResourcePtr<IMaterial>	pMaterial;
}

component Model
{
	[serialize][name="Model"]
	CResourcePtr<IModel> pModel;
}

[stage="on_update", profiler_group="scene"]
system QuadInit
{
	read: 				Quad quad;
	write_resource:		StudioScene		studioScene;
	exclude: 			StudioEntity;
}

[stage="on_update", profiler_group="scene"]
system ModelInit
{
	read: 				Model model;
	write_resource:		StudioScene		studioScene;
	exclude: 			StudioEntity;
}