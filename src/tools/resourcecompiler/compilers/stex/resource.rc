#include "tier0/defines.h"
#include "tier0/version.h"

1 VERSIONINFO
FILEVERSION     ENGINE_VERSION_MAJOR, ENGINE_VERSION_MINOR, ENGINE_VERSION_PATCH
PRODUCTVERSION  ENGINE_VERSION_MAJOR, ENGINE_VERSION_MINOR, ENGINE_VERSION_PATCH
FILEFLAGSMASK   0x3fL
#ifdef DEBUG
    FILEFLAGS   0x1L
#else
    FILEFLAGS   0x0L
#endif // DEBUG
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
 
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",        "Broken Singularity"
			VALUE "FileDescription", 	"Singularity Texture Compiler"
			VALUE "FileVersion",        ENGINE_VERSION_STRING
            VALUE "InternalName",       "resourcecompiler_stex"
            VALUE "LegalCopyright", 	"© 2020-2026 Broken Singularity"
            VALUE "OriginalFilename", 	"resourcecompiler_stex.dll"
            VALUE "ProductName", 		"Singularity Texture Compiler"
			VALUE "ProductVersion",     ENGINE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END