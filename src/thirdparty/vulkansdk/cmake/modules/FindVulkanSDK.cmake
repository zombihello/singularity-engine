# ---------------------------------
#	[in] 	VULKANSDK_PATH					- Root directory VulkanSDK
#	[out] 	VULKANSDK_INCLUDE				- Directory with includes
#	[out]	VULKANSDK_VULKAN_LIBS			- Libs Vulkan to link
#	[out]	VULKANSDK_VOLK_DEFINES			- Volk defines to set
#	[out]	VULKANSDK_VOLK_LIBS				- Libs Volk to link
#	[out]	VULKANSDK_SPIRVREFLECT_LIBS		- Libs SPIRVReflect to link
#	[out]	VULKANSDK_GLSLANG_LIBS			- Libs GLSLang to link
#	[out]	VULKANSDK_SHADERC_LIBS			- Libs ShaderC to link
#	[out]	VULKANSDK_SPIRVTOOLS_LIBS		- Libs SPIRVTools to link
#	[out]	VULKANSDK_SPIRVCROSS_LIBS		- Libs SPIRVCross to link
# 	[out] 	VULKANSDK_INSTALL_LICENSES		- VulkanSDK licenses to install
#	[out]	VULKANSDK_FOUND					- Is found VulkanSDK
# ---------------------------------

set( VULKANSDK_FOUND 			OFF )
set( VULKANSDK_SEARCH_PATHS 	$ENV{VULKAN_SDK} )


#
# Set path suffixed to libs for current platform
#
# Windows
if ( PLATFORM_WINDOWS )
	# Vulkan
	set( VULKANSDK_VULKAN_LIB_NAMES							"vulkan-1" )

	# Volk
	set( VULKANSDK_VOLK_DEFINES								VK_USE_PLATFORM_WIN32_KHR )

	# GLSLang
	set( VULKANSDK_GLSLANG_DEBUG_LIB_NAMES 					"glslangd" )
	set( VULKANSDK_OSDEPENDENT_DEBUG_LIB_NAMES 				"OSDependentd" )
	set( VULKANSDK_MACHINE_INDEPENDENT_DEBUG_LIB_NAMES 		"MachineIndependentd" )
	set( VULKANSDK_GENERIC_CODEGEN_DEBUG_LIB_NAMES 			"GenericCodeGend" )

	set( VULKANSDK_GLSLANG_RELEASE_LIB_NAMES 				"glslang" )
	set( VULKANSDK_OSDEPENDENT_RELEASE_LIB_NAMES 			"OSDependent" )
	set( VULKANSDK_MACHINE_INDEPENDENT_RELEASE_LIB_NAMES 	"MachineIndependent" )
	set( VULKANSDK_GENERIC_CODEGEN_RELEASE_LIB_NAMES 		"GenericCodeGen" )

	# ShaderC
	set( VULKANSDK_SHADERC_DEBUG_LIB_NAMES 					"shadercd" )
	set( VULKANSDK_SHADERC_UTIL_DEBUG_LIB_NAMES 			"shaderc_utild" )

	set( VULKANSDK_SHADERC_RELEASE_LIB_NAMES 				"shaderc" )
	set( VULKANSDK_SHADERC_UTIL_RELEASE_LIB_NAMES 			"shaderc_util" )

	# SPIRVTools
	set( VULKANSDK_SPIRV_DEBUG_LIB_NAMES 					"SPIRVd" )
	set( VULKANSDK_SPIRV_TOOLS_DEBUG_LIB_NAMES 				"SPIRV-Toolsd" )
	set( VULKANSDK_SPIRV_TOOLS_DIFF_DEBUG_LIB_NAMES 		"SPIRV-Tools-diffd" )
	set( VULKANSDK_SPIRV_TOOLS_LINK_DEBUG_LIB_NAMES 		"SPIRV-Tools-linkd" )
	set( VULKANSDK_SPIRV_TOOLS_LINT_DEBUG_LIB_NAMES 		"SPIRV-Tools-lintd" )
	set( VULKANSDK_SPIRV_TOOLS_OPT_DEBUG_LIB_NAMES 			"SPIRV-Tools-optd" )
	set( VULKANSDK_SPIRV_TOOLS_REDUCE_DEBUG_LIB_NAMES 		"SPIRV-Tools-reduced" )

	set( VULKANSDK_SPIRV_RELEASE_LIB_NAMES 					"SPIRV" )
	set( VULKANSDK_SPIRV_TOOLS_RELEASE_LIB_NAMES 			"SPIRV-Tools" )
	set( VULKANSDK_SPIRV_TOOLS_DIFF_RELEASE_LIB_NAMES 		"SPIRV-Tools-diff" )
	set( VULKANSDK_SPIRV_TOOLS_LINK_RELEASE_LIB_NAMES 		"SPIRV-Tools-link" )
	set( VULKANSDK_SPIRV_TOOLS_LINT_RELEASE_LIB_NAMES 		"SPIRV-Tools-lint" )
	set( VULKANSDK_SPIRV_TOOLS_OPT_RELEASE_LIB_NAMES 		"SPIRV-Tools-opt" )
	set( VULKANSDK_SPIRV_TOOLS_REDUCE_RELEASE_LIB_NAMES 	"SPIRV-Tools-reduce" )

	# SPIRVCross
	set( VULKANSDK_SPIRVCROSS_CORE_DEBUG_LIB_NAMES 			"spirv-cross-cored" )
	set( VULKANSDK_SPIRVCROSS_CORE_RELEASE_LIB_NAMES 		"spirv-cross-core" )

# Unknown platform
else()
	message( SEND_ERROR "VulkanSDK :: Unknown platform" )
	return()
endif()


#
# Find pathes
#
# Includes
find_path( 		VULKANSDK_INCLUDE
				NO_DEFAULT_PATH
				NAMES "vulkan/vulkan.h"
				PATH_SUFFIXES Include
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_path( 		VULKANSDK_SOURCE
				NO_DEFAULT_PATH
				NAMES "SPIRV-Reflect/spirv_reflect.c"
				PATH_SUFFIXES Source
				PATHS ${VULKANSDK_SEARCH_PATHS} )

# Libs
# Vulkan
find_library( 	VULKANSDK_VULKAN_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_VULKAN_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )

# GLSLang
find_library( 	VULKANSDK_GLSLANG_DEBUG_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_GLSLANG_DEBUG_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_OSDEPENDENT_DEBUG_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_OSDEPENDENT_DEBUG_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_MACHINE_INDEPENDENT_DEBUG_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_MACHINE_INDEPENDENT_DEBUG_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_GENERIC_CODEGEN_DEBUG_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_GENERIC_CODEGEN_DEBUG_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )

find_library( 	VULKANSDK_GLSLANG_RELEASE_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_GLSLANG_RELEASE_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_OSDEPENDENT_RELEASE_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_OSDEPENDENT_RELEASE_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_MACHINE_INDEPENDENT_RELEASE_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_MACHINE_INDEPENDENT_RELEASE_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_GENERIC_CODEGEN_RELEASE_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_GENERIC_CODEGEN_RELEASE_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )

# ShaderC
find_library( 	VULKANSDK_SHADERC_DEBUG_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SHADERC_DEBUG_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_SHADERC_UTIL_DEBUG_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SHADERC_UTIL_DEBUG_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )

find_library( 	VULKANSDK_SHADERC_RELEASE_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SHADERC_RELEASE_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_SHADERC_UTIL_RELEASE_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SHADERC_UTIL_RELEASE_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )

# SPIRVTools
find_library( 	VULKANSDK_SPIRV_DEBUG_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SPIRV_DEBUG_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_SPIRV_TOOLS_DEBUG_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SPIRV_TOOLS_DEBUG_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_SPIRV_TOOLS_DIFF_DEBUG_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SPIRV_TOOLS_DIFF_DEBUG_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_SPIRV_TOOLS_LINK_DEBUG_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SPIRV_TOOLS_LINK_DEBUG_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_SPIRV_TOOLS_LINT_DEBUG_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SPIRV_TOOLS_LINT_DEBUG_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_SPIRV_TOOLS_OPT_DEBUG_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SPIRV_TOOLS_OPT_DEBUG_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_SPIRV_TOOLS_REDUCE_DEBUG_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SPIRV_TOOLS_REDUCE_DEBUG_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )

find_library( 	VULKANSDK_SPIRV_RELEASE_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SPIRV_RELEASE_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )				
find_library( 	VULKANSDK_SPIRV_TOOLS_RELEASE_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SPIRV_TOOLS_RELEASE_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_SPIRV_TOOLS_DIFF_RELEASE_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SPIRV_TOOLS_DIFF_RELEASE_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_SPIRV_TOOLS_LINK_RELEASE_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SPIRV_TOOLS_LINK_RELEASE_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_SPIRV_TOOLS_LINT_RELEASE_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SPIRV_TOOLS_LINT_RELEASE_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_SPIRV_TOOLS_OPT_RELEASE_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SPIRV_TOOLS_OPT_RELEASE_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_SPIRV_TOOLS_REDUCE_RELEASE_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SPIRV_TOOLS_REDUCE_RELEASE_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )

# SPIRVCross
find_library( 	VULKANSDK_SPIRVCROSS_CORE_DEBUG_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SPIRVCROSS_CORE_DEBUG_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_library( 	VULKANSDK_SPIRVCROSS_CORE_RELEASE_LIB
				NO_DEFAULT_PATH
                NAMES ${VULKANSDK_SPIRVCROSS_CORE_RELEASE_LIB_NAMES}
				PATH_SUFFIXES Lib
				PATHS ${VULKANSDK_SEARCH_PATHS} )

# Source files
# Volk
find_file( 		VULKANSDK_VOLK_C_FILE
				NO_DEFAULT_PATH
				NAMES "volk.c"
				PATH_SUFFIXES Include/Volk
				PATHS ${VULKANSDK_SEARCH_PATHS} )
find_file( 		VULKANSDK_VOLK_H_FILE
				NO_DEFAULT_PATH
				NAMES "volk.h"
				PATH_SUFFIXES Include/Volk
				PATHS ${VULKANSDK_SEARCH_PATHS} )

# SPIRVReflect
find_file( 		VULKANSDK_SPIRVREFLECT_C_FILE
				NO_DEFAULT_PATH
				NAMES "spirv_reflect.c"
				PATH_SUFFIXES Source/SPIRV-Reflect
				PATHS ${VULKANSDK_SEARCH_PATHS} )				

# Licenses
find_file( 		VULKANSDK_LICENSE_TXT
				NO_DEFAULT_PATH
				NAMES "LICENSE.txt"
				PATH_SUFFIXES Licenses
				PATHS ${VULKANSDK_SEARCH_PATHS} )


if ( NOT VULKANSDK_INCLUDE OR NOT VULKANSDK_VULKAN_LIB OR NOT VULKANSDK_VOLK_C_FILE OR NOT VULKANSDK_VOLK_H_FILE
	OR NOT VULKANSDK_SPIRVREFLECT_C_FILE OR NOT VULKANSDK_GLSLANG_DEBUG_LIB OR NOT VULKANSDK_OSDEPENDENT_DEBUG_LIB
	OR NOT VULKANSDK_MACHINE_INDEPENDENT_DEBUG_LIB OR NOT VULKANSDK_GENERIC_CODEGEN_DEBUG_LIB OR NOT VULKANSDK_GLSLANG_RELEASE_LIB
	OR NOT VULKANSDK_OSDEPENDENT_RELEASE_LIB OR NOT VULKANSDK_MACHINE_INDEPENDENT_RELEASE_LIB OR NOT VULKANSDK_GENERIC_CODEGEN_RELEASE_LIB
	OR NOT VULKANSDK_SHADERC_DEBUG_LIB OR NOT VULKANSDK_SHADERC_UTIL_DEBUG_LIB OR NOT VULKANSDK_SHADERC_RELEASE_LIB
	OR NOT VULKANSDK_SHADERC_UTIL_RELEASE_LIB OR NOT VULKANSDK_SPIRV_DEBUG_LIB OR NOT VULKANSDK_SPIRV_TOOLS_DEBUG_LIB
	OR NOT VULKANSDK_SPIRV_TOOLS_DIFF_DEBUG_LIB OR NOT VULKANSDK_SPIRV_TOOLS_LINK_DEBUG_LIB OR NOT VULKANSDK_SPIRV_TOOLS_LINT_DEBUG_LIB
	OR NOT VULKANSDK_SPIRV_TOOLS_OPT_DEBUG_LIB OR NOT VULKANSDK_SPIRV_TOOLS_REDUCE_DEBUG_LIB OR NOT VULKANSDK_SPIRV_RELEASE_LIB
	OR NOT VULKANSDK_SPIRV_TOOLS_RELEASE_LIB OR NOT VULKANSDK_SPIRV_TOOLS_DIFF_RELEASE_LIB OR NOT VULKANSDK_SPIRV_TOOLS_LINK_RELEASE_LIB
	OR NOT VULKANSDK_SPIRV_TOOLS_LINT_RELEASE_LIB OR NOT VULKANSDK_SPIRV_TOOLS_OPT_RELEASE_LIB OR NOT VULKANSDK_SPIRV_TOOLS_REDUCE_RELEASE_LIB
	OR NOT VULKANSDK_SPIRVCROSS_CORE_DEBUG_LIB OR NOT VULKANSDK_SPIRVCROSS_CORE_RELEASE_LIB )
	message( SEND_ERROR "VulkanSDK :: Not found" )
	return()
else()
	set( VULKANSDK_FOUND 				ON )
	set( VULKANSDK_VULKAN_LIBS			${VULKANSDK_VULKAN_LIB} )
	set( VULKANSDK_VOLK_LIBS			Volk )
	set( VULKANSDK_SPIRVREFLECT_LIBS	SPIRVReflect )
	set( VULKANSDK_GLSLANG_LIBS			$<$<CONFIG:Debug>:${VULKANSDK_GLSLANG_DEBUG_LIB} ${VULKANSDK_OSDEPENDENT_DEBUG_LIB}
														  ${VULKANSDK_MACHINE_INDEPENDENT_DEBUG_LIB} ${VULKANSDK_GENERIC_CODEGEN_DEBUG_LIB}> 
										$<$<CONFIG:Release,Retail>:${VULKANSDK_GLSLANG_RELEASE_LIB} ${VULKANSDK_OSDEPENDENT_RELEASE_LIB}
																   ${VULKANSDK_MACHINE_INDEPENDENT_RELEASE_LIB} ${VULKANSDK_GENERIC_CODEGEN_RELEASE_LIB}> )
	set( VULKANSDK_SHADERC_LIBS			$<$<CONFIG:Debug>:${VULKANSDK_SHADERC_DEBUG_LIB} ${VULKANSDK_SHADERC_UTIL_DEBUG_LIB}>
										$<$<CONFIG:Release,Retail>:${VULKANSDK_SHADERC_RELEASE_LIB} ${VULKANSDK_SHADERC_UTIL_RELEASE_LIB}> )
	set( VULKANSDK_SPIRVTOOLS_LIBS		$<$<CONFIG:Debug>:${VULKANSDK_SPIRV_DEBUG_LIB} ${VULKANSDK_SPIRV_TOOLS_DEBUG_LIB}
														  ${VULKANSDK_SPIRV_TOOLS_DIFF_DEBUG_LIB} ${VULKANSDK_SPIRV_TOOLS_LINK_DEBUG_LIB}
														  ${VULKANSDK_SPIRV_TOOLS_LINT_DEBUG_LIB} ${VULKANSDK_SPIRV_TOOLS_OPT_DEBUG_LIB}
														  ${VULKANSDK_SPIRV_TOOLS_REDUCE_DEBUG_LIB} >
										$<$<CONFIG:Release,Retail>:${VULKANSDK_SPIRV_RELEASE_LIB} ${VULKANSDK_SPIRV_TOOLS_RELEASE_LIB}
																   ${VULKANSDK_SPIRV_TOOLS_DIFF_RELEASE_LIB} ${VULKANSDK_SPIRV_TOOLS_LINK_RELEASE_LIB} 
																   ${VULKANSDK_SPIRV_TOOLS_LINT_RELEASE_LIB} ${VULKANSDK_SPIRV_TOOLS_OPT_RELEASE_LIB}
																   ${VULKANSDK_SPIRV_TOOLS_REDUCE_RELEASE_LIB}> )
	set( VULKANSDK_SPIRVCROSS_LIBS		$<$<CONFIG:Debug>:${VULKANSDK_SPIRVCROSS_CORE_DEBUG_LIB}>
										$<$<CONFIG:Release,Retail>:${VULKANSDK_SPIRVCROSS_CORE_RELEASE_LIB}> )
	set( VULKANSDK_INSTALL_LICENSES		${VULKANSDK_LICENSE_TXT} )

	include( ${VULKANSDK_PATH}/cmake/volk.cmake )
	include( ${VULKANSDK_PATH}/cmake/spirvreflect.cmake )
endif()
