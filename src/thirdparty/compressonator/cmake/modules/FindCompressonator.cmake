# ---------------------------------
#	[in] 	COMPRESSONATOR_PATH						- Root directory Compressonator
#	[out] 	COMPRESSONATOR_INCLUDE					- Directory with includes
#	[out]	COMPRESSONATOR_LIBS						- Libs Compressonator to link
# 	[out] 	COMPRESSONATOR_INSTALL_LICENSES_DIR		- Compressonator licenses to install
# 	[out] 	COMPRESSONATOR_INSTALL_DLLS_DEBUG 		- Compressonator DLLs to install (Debug)
# 	[out] 	COMPRESSONATOR_INSTALL_DLLS_RELEASE 	- Compressonator DLLs to install (Release)
#	[out]	COMPRESSONATOR_FOUND					- Is found Compressonator
# ---------------------------------

set( COMPRESSONATOR_FOUND 			OFF )
set( COMPRESSONATOR_SEARCH_PATHS 	${COMPRESSONATOR_PATH} )


#
# Set path suffixed to libs for current platform
#
# Windows
if ( PLATFORM_WINDOWS )
	if ( PLATFORM_64BIT )
		set( COMPRESSONATOR_LIB_PATH_SUFFIXES		"lib/win64" )
		set( COMPRESSONATOR_BIN_PATH_SUFFIXES		"bin/win64" )
	elseif( PLATFORM_32BIT )
		set( COMPRESSONATOR_LIB_PATH_SUFFIXES		"lib/win32" )
		set( COMPRESSONATOR_BIN_PATH_SUFFIXES		"bin/win32" )
	else()
		message( SEND_ERROR "Compressonator :: Unknown bit platform" )
		return()
	endif()

	set( COMPRESSONATOR_DEBUG_LIB_NAMES					"Compressonator_MDd_DLL" )
	set( COMPRESSONATOR_DEBUG_DLL_NAMES					"Compressonator_MDd_DLL.dll" )
	set( COMPRESSONATOR_FRAMEWORK_DEBUG_LIB_NAMES		"CMP_Framework_MDd_DLL" )
	set( COMPRESSONATOR_FRAMEWORK_DEBUG_DLL_NAMES		"CMP_Framework_MDd_DLL.dll" )

	set( COMPRESSONATOR_RELEASE_LIB_NAMES				"Compressonator_MD_DLL" )
	set( COMPRESSONATOR_RELEASE_DLL_NAMES				"Compressonator_MD_DLL.dll" )
	set( COMPRESSONATOR_FRAMEWORK_RELEASE_LIB_NAMES		"CMP_Framework_MD_DLL" )
	set( COMPRESSONATOR_FRAMEWORK_RELEASE_DLL_NAMES		"CMP_Framework_MD_DLL.dll" )

# Unknown platform
else()
	message( SEND_ERROR "Compressonator :: Unknown platform" )
	return()
endif()


#
# Find pathes
#
# Includes
find_path( 		COMPRESSONATOR_INCLUDE
				NO_DEFAULT_PATH
				NAMES "compressonator.h"
				PATH_SUFFIXES include
				PATHS ${COMPRESSONATOR_SEARCH_PATHS} )

# Libs
find_library( 	COMPRESSONATOR_DEBUG_LIB
				NO_DEFAULT_PATH
                NAMES ${COMPRESSONATOR_DEBUG_LIB_NAMES}
				PATH_SUFFIXES ${COMPRESSONATOR_LIB_PATH_SUFFIXES}/debug
                PATHS ${COMPRESSONATOR_SEARCH_PATHS} )
find_library( 	COMPRESSONATOR_FRAMEWORK_DEBUG_LIB
				NO_DEFAULT_PATH
                NAMES ${COMPRESSONATOR_FRAMEWORK_DEBUG_LIB_NAMES}
				PATH_SUFFIXES ${COMPRESSONATOR_LIB_PATH_SUFFIXES}/debug
                PATHS ${COMPRESSONATOR_SEARCH_PATHS} )				
find_library( 	COMPRESSONATOR_RELEASE_LIB
				NO_DEFAULT_PATH
                NAMES ${COMPRESSONATOR_RELEASE_LIB_NAMES}
				PATH_SUFFIXES ${COMPRESSONATOR_LIB_PATH_SUFFIXES}/release
                PATHS ${COMPRESSONATOR_SEARCH_PATHS} )				
find_library( 	COMPRESSONATOR_FRAMEWORK_RELEASE_LIB
				NO_DEFAULT_PATH
                NAMES ${COMPRESSONATOR_FRAMEWORK_RELEASE_LIB_NAMES}
				PATH_SUFFIXES ${COMPRESSONATOR_LIB_PATH_SUFFIXES}/release
                PATHS ${COMPRESSONATOR_SEARCH_PATHS} )
				
# DLLs
find_file( 		COMPRESSONATOR_DEBUG_DLL
				NO_DEFAULT_PATH
                NAMES ${COMPRESSONATOR_DEBUG_DLL_NAMES}
				PATH_SUFFIXES ${COMPRESSONATOR_BIN_PATH_SUFFIXES}/debug
                PATHS ${COMPRESSONATOR_SEARCH_PATHS} )
find_file( 		COMPRESSONATOR_FRAMEWORK_DEBUG_DLL
				NO_DEFAULT_PATH
                NAMES ${COMPRESSONATOR_FRAMEWORK_DEBUG_DLL_NAMES}
				PATH_SUFFIXES ${COMPRESSONATOR_BIN_PATH_SUFFIXES}/debug
                PATHS ${COMPRESSONATOR_SEARCH_PATHS} )				
find_file( 		COMPRESSONATOR_RELEASE_DLL
				NO_DEFAULT_PATH
                NAMES ${COMPRESSONATOR_RELEASE_DLL_NAMES}
				PATH_SUFFIXES ${COMPRESSONATOR_BIN_PATH_SUFFIXES}/release
                PATHS ${COMPRESSONATOR_SEARCH_PATHS} )
find_file( 		COMPRESSONATOR_FRAMEWORK_RELEASE_DLL
				NO_DEFAULT_PATH
                NAMES ${COMPRESSONATOR_FRAMEWORK_RELEASE_DLL_NAMES}
				PATH_SUFFIXES ${COMPRESSONATOR_BIN_PATH_SUFFIXES}/release
                PATHS ${COMPRESSONATOR_SEARCH_PATHS} )	

# Linceses
find_path( 		COMPRESSONATOR_LICENSE_DIR
				NO_DEFAULT_PATH
				NAMES "README.md"
				PATH_SUFFIXES license
				PATHS ${COMPRESSONATOR_SEARCH_PATHS} )


if ( NOT COMPRESSONATOR_INCLUDE OR NOT COMPRESSONATOR_DEBUG_LIB OR NOT COMPRESSONATOR_FRAMEWORK_DEBUG_LIB 
	OR NOT COMPRESSONATOR_RELEASE_LIB OR NOT COMPRESSONATOR_FRAMEWORK_RELEASE_LIB OR NOT COMPRESSONATOR_DEBUG_DLL
	OR NOT COMPRESSONATOR_FRAMEWORK_DEBUG_DLL OR NOT COMPRESSONATOR_RELEASE_DLL OR NOT COMPRESSONATOR_FRAMEWORK_RELEASE_DLL )
	message( SEND_ERROR "Compressonator :: Not found" )
	return()
else()
	set( COMPRESSONATOR_FOUND 					ON )
	set( COMPRESSONATOR_LIBS					$<$<CONFIG:Debug>:${COMPRESSONATOR_DEBUG_LIB} ${COMPRESSONATOR_FRAMEWORK_DEBUG_LIB}> 
												$<$<CONFIG:Release,Retail>:${COMPRESSONATOR_RELEASE_LIB} ${COMPRESSONATOR_FRAMEWORK_RELEASE_LIB}> )
	set( COMPRESSONATOR_INSTALL_LICENSES_DIR	${COMPRESSONATOR_LICENSE_DIR} )
	set( COMPRESSONATOR_INSTALL_DLLS_DEBUG 		${COMPRESSONATOR_DEBUG_DLL} ${COMPRESSONATOR_FRAMEWORK_DEBUG_DLL} )
	set( COMPRESSONATOR_INSTALL_DLLS_RELEASE 	${COMPRESSONATOR_RELEASE_DLL} ${COMPRESSONATOR_FRAMEWORK_RELEASE_DLL} )
endif()