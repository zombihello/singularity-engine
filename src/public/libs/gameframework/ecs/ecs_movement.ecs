// FOR TEST ONLY!
module Movement;
using "stdlib/math/transform.h";
using "stdlib/math/math.h";

component Transform
{
	CTransform	transform;
}

component Velocity
{
	defaults: speed( 0.f );
	float speed;
}

component Moveable
{}

component Freezed
{}

system Movement
{
	stage: 			on_update;
	read:
		Transform	transform,
		Velocity	velocity;
		
	include: 	Moveable;
	exclude: 	Freezed;
}
