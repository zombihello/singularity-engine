module Camera;
using "gameframework/ecs/ecs_common.gen.h";
using "gameframework/ecs/ecs_render.gen.h";
using "gameframework/ecs/ecs_movement.gen.h";

component Camera
{
	defaults:
		bAutoViewData( false ),
		fieldOfView( 90.f ),
		nearClipPlane( 0.01f ),
		farClipPlane( 524288.0 * 0.5 ),
		aspectRatio( 1.777778f );

	[serialize] bool	bAutoViewData;
	[serialize] float	fieldOfView;
	[serialize] float	nearClipPlane;
	[serialize] float	farClipPlane;
	[serialize] float	aspectRatio;
}

component CameraInited
{}

component CameraActive
{}

system CameraInit
{
	stage:				on_update;
	write:				Camera		camera;
	read_resource:		WindowMgr	windowMgr;
	exclude:			CameraInited;
}

system UpdateCameraView
{
	stage: 				on_store;
	read:				Transform		transform,
						Camera			camera;
	read_resource:		StudioRender	studioRender;
	include:			CameraInited, CameraActive;
}